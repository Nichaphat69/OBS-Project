{
  "name": "OBS 2 — ตรวจรอบบิลรายวัน",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [{ "field": "cronExpression", "expression": "0 9 * * 1-5" }]
        }
      },
      "id": "schedule",
      "name": "ทุกวันทำการ 09:00",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [-320, 300],
      "notes": "จับรอบบิลที่ครบแล้วแต่ยังไม่ได้วางบิล เผื่อกรณีที่ Timesheet คนสุดท้ายเข้ามาตอนกลางคืน"
    },
    {
      "parameters": {
        "url": "={{ $vars.OBS_BASE_URL }}/api/cycles/ready",
        "options": {}
      },
      "id": "get-ready",
      "name": "ถามระบบว่ารอบไหนพร้อมวางบิล",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [-100, 300],
      "notes": "ระบบคำนวณเงื่อนไขให้แล้ว — n8n ไม่ต้องรู้กฎธุรกิจ"
    },
    {
      "parameters": {
        "fieldToSplitOut": "cycles",
        "options": {}
      },
      "id": "split",
      "name": "แยกทีละรอบบิล",
      "type": "n8n-nodes-base.splitOut",
      "typeVersion": 1,
      "position": [120, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "version": 2 },
          "combinator": "and",
          "conditions": [
            {
              "leftValue": "={{ $json.canApprove }}",
              "rightValue": true,
              "operator": { "type": "boolean", "operation": "true", "singleValue": true }
            }
          ]
        },
        "options": {}
      },
      "id": "gate-can",
      "name": "อนุมัติได้จริงไหม",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [340, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $vars.OBS_BASE_URL }}/api/cycles/{{ $json.contractId }}/{{ $json.period }}/approve",
        "options": { "timeout": 60000 }
      },
      "id": "approve",
      "name": "สร้างร่างใบแจ้งหนี้",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [580, 200],
      "notes": "เอาออกจาก workflow นี้ถ้าต้องการให้คนกดอนุมัติเองในหน้าเว็บทุกครั้ง"
    },
    {
      "parameters": {},
      "id": "notify-blocked",
      "name": "แจ้งทีมว่าติดอะไรอยู่",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [580, 400],
      "notes": "แทนด้วย Slack / Line node · ข้อมูลที่ควรส่ง: $json.periodLabel, $json.blockers"
    }
  ],
  "connections": {
    "ทุกวันทำการ 09:00": {
      "main": [[{ "node": "ถามระบบว่ารอบไหนพร้อมวางบิล", "type": "main", "index": 0 }]]
    },
    "ถามระบบว่ารอบไหนพร้อมวางบิล": {
      "main": [[{ "node": "แยกทีละรอบบิล", "type": "main", "index": 0 }]]
    },
    "แยกทีละรอบบิล": {
      "main": [[{ "node": "อนุมัติได้จริงไหม", "type": "main", "index": 0 }]]
    },
    "อนุมัติได้จริงไหม": {
      "main": [
        [{ "node": "สร้างร่างใบแจ้งหนี้", "type": "main", "index": 0 }],
        [{ "node": "แจ้งทีมว่าติดอะไรอยู่", "type": "main", "index": 0 }]
      ]
    }
  },
  "settings": { "executionOrder": "v1" },
  "pinData": {}
}
