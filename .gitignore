node_modules/

# ฐานข้อมูลและไฟล์ชั่วคราวของ sqlite — เป็นข้อมูลรันจริง ไม่ใช่ซอร์ส
data/
*.sqlite
*.sqlite-shm
*.sqlite-wal

# ความลับทั้งหมด — API key · client secret · refresh token
.env
.env.*
!.env.example
!.env.production.example

*.log
.DS_Store

# cookie jar ของ curl ตอนทดสอบ — มี session token จริง ห้ามขึ้น repo
cookies.txt

# ไฟล์ล็อกชั่วคราวของ Word/Excel
~$*

# เอกสารต้นฉบับของลูกค้า — ห้ามขึ้น repo
docs/*.pdf
# ยกเว้นเอกสารที่เราสร้างเอง (ขึ้นต้นด้วย OBS_) ซึ่งเป็นของส่งมอบ ไม่ใช่ของลูกค้า
!docs/OBS_*.pdf
docs/*.xlsx
docs/*.docx

# คีย์ SSH ของเซิร์ฟเวอร์ — ห้ามขึ้น repo เด็ดขาด (วางไว้ในโฟลเดอร์นี้เพื่อความสะดวกเท่านั้น)
*.pem
*.ppk
*.key

# เอกสารโครงสร้างเซิร์ฟเวอร์ — มี IP · Security Group · พอร์ตภายใน
