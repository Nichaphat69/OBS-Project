{
  "name": "@obs/api",
  "version": "0.1.0",
  "private": true,
  "description": "Express + TypeScript REST API — new-stack backend (auth + read-only dashboard slice, ported from src/auth.js and src/service.js).",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "test": "node --env-file-if-exists=../../.env --import tsx --import ./test/helpers/useTestDb.ts --test --test-concurrency=1 \"test/**/*.test.ts\"",
    "test:db:setup": "node --env-file-if-exists=../../.env --import tsx ./test/helpers/createTestDb.ts",
    "typecheck": "tsc --noEmit",
    "typecheck:test": "tsc -p tsconfig.test.json",
    "user:create": "node --env-file-if-exists=../../.env --import tsx ./scripts/create-user.ts",
    "user:reset-password": "node --env-file-if-exists=../../.env --import tsx ./scripts/reset-password.ts"
  },
  "dependencies": {
    "@obs/db": "*",
    "@obs/domain": "*",
    "@sentry/node": "^11.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "express-async-errors": "^3.1.1",
    "pdf-to-img": "^6.2.0",
    "pdfjs-dist": "~5.6.205",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
