# ── .env.production — คัดลอกเป็น .env.production แล้วใส่ค่าจริง ห้าม commit ─────────────────
#
# ไฟล์นี้ต่างจาก .env.example ตรงที่ไล่ทีละบรรทัดว่า "ค่า production ต้องหน้าตายังไง" ไม่ใช่แค่ว่ามีคีย์
# อะไรบ้าง — เพราะจุดที่พลาดง่ายที่สุดของ go-live ไม่ใช่คีย์ที่ลืมใส่ (ระบบฟ้องเอง) แต่เป็นคีย์ที่ใส่ไว้
# แล้วแต่ยังเป็นค่าของเครื่องทดสอบ ระบบจะทำงานได้ปกติทุกอย่างแต่ไปคุยกับปลายทางผิดตัวแบบเงียบๆ
#
# ⚠️ ตรวจแล้วเมื่อ 28 ก.ย. 69 บนเครื่องทดสอบ ค่าที่ยังชี้ไป test/dev มี 8 ตัว ทำเครื่องหมาย [ต่างจากเทสต์]
#    ไว้ทุกตัวด้านล่าง อย่าคัดลอก .env ของเครื่องทดสอบมาทั้งไฟล์เด็ดขาด

# ── โดเมนและ TLS (ใช้โดย docker-compose.prod.yml + Caddyfile) ────────────────────
# ต้องชี้ DNS ของทั้งสองชื่อมาที่เครื่อง production ก่อนสตาร์ท ไม่งั้น Caddy ขอใบรับรองไม่ผ่าน
PUBLIC_DOMAIN=obs.ipassion.co.th
API_DOMAIN=obs-api.ipassion.co.th
TLS_EMAIL=

# ── ฐานข้อมูล ───────────────────────────────────────────────────────────────
# [ต่างจากเทสต์] ต้องตั้งรหัสใหม่สำหรับ production ห้ามใช้ซ้ำกับเครื่องทดสอบ
POSTGRES_USER=obs
POSTGRES_PASSWORD=
POSTGRES_DB=obs
# เก็บไฟล์สำรองย้อนหลังกี่วัน (pg-backup ใน compose)
BACKUP_KEEP_DAYS=14
# ใช้เฉพาะเครื่องมือฝั่ง host (prisma migrate dev / สคริปต์) — คอนเทนเนอร์ api ไม่ได้ใช้ค่านี้
# compose ตั้ง DATABASE_URL ที่ชี้ไป service `postgres` ให้เองอยู่แล้ว
DATABASE_URL=

# ── ที่อยู่ของระบบ ──────────────────────────────────────────────────────────
# [ต่างจากเทสต์] เครื่องทดสอบตั้ง APP_BASE_URL เป็น http://192.168.0.20:4300 ซึ่งเป็น IP วงแลน
# ลิงก์ที่ระบบสร้างส่งเข้า LINE/อีเมลจะเปิดไม่ได้จากนอกออฟฟิศ — production ต้องเป็นโดเมนจริง https
APP_BASE_URL=https://obs-api.ipassion.co.th
WEB_BASE_URL=https://obs.ipassion.co.th

# ── เข้าสู่ระบบด้วย Google ──────────────────────────────────────────────────
# [ต่างจากเทสต์] ต้องเปลี่ยนเป็นโดเมนจริง **และ** ไปเพิ่ม URI นี้ใน Google Cloud Console →
# Credentials → OAuth client → Authorized redirect URIs ให้ตรงเป๊ะ ไม่งั้นล็อกอินไม่ผ่าน
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://obs.ipassion.co.th/api/auth/google/callback

# ── FlowAccount ─────────────────────────────────────────────────────────────
# ตกลงกันเมื่อ 28 ก.ย. 69 ว่า go-live รอบแรกยังใช้ sandbox ไปก่อน — เอกสารจะยังไม่ออกจริงในบัญชีบริษัท
# วันที่จะสลับเป็นของจริง เปลี่ยนสามบรรทัดนี้พร้อมกัน (mode + base url + client id/secret ของบัญชีจริง)
#   live: FLOWACCOUNT_MODE=live · FLOWACCOUNT_BASE_URL=<base ของ production ที่ FlowAccount ให้มา>
FLOWACCOUNT_MODE=sandbox
FLOWACCOUNT_BASE_URL=https://openapi.flowaccount.com/test
FLOWACCOUNT_SCOPE=flowaccount-api
FLOWACCOUNT_CLIENT_ID=
FLOWACCOUNT_CLIENT_SECRET=

# ── LINE ────────────────────────────────────────────────────────────────────
# ใช้ channel ของ production ไม่ใช่ channel ที่ใช้ทดสอบ และต้องไปตั้ง Webhook URL ใน LINE Developers
# Console เป็น https://obs-api.ipassion.co.th/api/line/webhook (ชี้ที่ API_DOMAIN ไม่ใช่หน้าเว็บ)
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=
LINE_LOGIN_CHANNEL_ID=
LINE_LOGIN_CHANNEL_SECRET=
# ปลายทางเริ่มต้นตอนยังไม่มีใครผูกบัญชี — ปกติปล่อยว่างแล้วให้ระบบหาผู้รับตาม role เอง
LINE_APPROVER_TARGET=
LINE_APPROVER_USER_IDS=

# ── Gmail (ดึงเมลอนุมัติ + สร้างร่างอีเมลวางบิล) ────────────────────────────
# refresh token ผูกกับบัญชีที่กด consent ไว้ — ถ้า production ใช้คนละกล่องเมลกับตอนทดสอบ ต้องขอใหม่
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_QUERY=

# ── ตัวอ่านเอกสาร ───────────────────────────────────────────────────────────
ABBYY_BASE_URL=https://vantage-au.abbyy.com
ABBYY_CLIENT_ID=
ABBYY_CLIENT_SECRET=
ABBYY_SKILL_ID=
# [ต่างจากเทสต์] เครื่องทดสอบชี้ไป ai.prior-dev.app ซึ่งชื่อโฮสต์บอกว่าเป็น dev ของผู้ให้บริการ
# ต้องถาม Clear Read ว่ามี endpoint production แยกไหม ก่อนใช้กับข้อมูลจริง
CLEAR_READ_BASE_URL=
CLEAR_READ_EMAIL=
CLEAR_READ_PASSWORD=
CLEAR_READ_PROJECT_ID=
CLEAR_READ_TEMPLATE_ID=

# [ต่างจากเทสต์] เครื่องทดสอบชี้ไป 100.78.131.96 ซึ่งเป็นเครื่องในวง Tailscale/VPN ของคนใดคนหนึ่ง
# production ต้องมีเครื่องที่รันโมเดลของตัวเอง หรือปล่อยว่างถ้าจะใช้แต่ ABBYY/Clear Read
LOCAL_LLM_BASE_URL=
LOCAL_LLM_MODEL=
LOCAL_LLM_VISION_MODEL=

# ── HRDD (ระบบเช็คชื่อบริษัทหลัก) ───────────────────────────────────────────
# [ต่างจากเทสต์] เครื่องทดสอบใช้ http เปล่าชี้ IP ตรง — ถ้ามี https/โดเมนของ production ให้ใช้อันนั้น
HRDD_BASE_URL=
HRDD_USERNAME=
HRDD_PASSWORD=

# ── n8n ─────────────────────────────────────────────────────────────────────
# [ต่างจากเทสต์] ตั้งค่าใหม่สำหรับ production — ต้องใส่เป็น header x-n8n-secret ในทุก HTTP node
# ของ workflow ด้วย ไม่งั้นโดน 401 (เกิดขึ้นจริงมาแล้ว 5 วันทำการบนเครื่อง dev)
N8N_SHARED_SECRET=
# กุญแจถอดรหัส credential ที่เก็บใน n8n — ตั้งครั้งเดียวแล้วห้ามเปลี่ยน ถ้าเปลี่ยนจะอ่าน credential เดิมไม่ได้
N8N_ENCRYPTION_KEY=
N8N_PORT=5678
TZ=Asia/Bangkok

# ── ที่เก็บไฟล์ (Garage — S3-compatible) ────────────────────────────────────
# ใช้ Garage ไม่ใช่ MinIO เพราะ MinIO ปิด image สาธารณะไปแล้ว (ตรวจเมื่อ 28 ก.ย. 69)
# api เรียกผ่านเครือข่าย Docker ภายในที่ http://storage:3900 ไม่เปิดพอร์ตออกเครื่องเลย
# ไม่มีหน้าเว็บคอนโซลให้เข้า — จัดการผ่าน `docker compose exec storage /garage ...` แทน
#
# ทั้งสามค่านี้สร้างตอนติดตั้งครั้งแรก:
#   STORAGE_RPC_SECRET  : openssl rand -hex 32  (เปลี่ยนแล้วโหนดจะคุยกันไม่ได้ ตั้งครั้งเดียว)
#   STORAGE_ACCESS_KEY / STORAGE_SECRET_KEY : ได้จาก `garage key create obs-api` หลังคอนเทนเนอร์ขึ้น
STORAGE_RPC_SECRET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_BUCKET=obs-files
STORAGE_ENDPOINT=http://storage:3900
STORAGE_REGION=garage

# ── กุญแจเข้ารหัสค่าลับในฐานข้อมูล ──────────────────────────────────────────
# ใช้กับสิทธิ์เข้าถึงกล่อง Gmail ที่ผูกจากหน้าเว็บ (ตาราง gmail_connections) — เข้ารหัสไว้เพื่อกันกรณี
# ไฟล์สำรองฐานข้อมูลหลุดออกไปนอกเครื่อง ซึ่งเป็นทางที่ข้อมูลรั่วได้ง่ายที่สุดเพราะ pg_dump ออกทุกคืน
# สร้างด้วย `openssl rand -hex 32` · ตั้งครั้งเดียวแล้วห้ามเปลี่ยน ถ้าเปลี่ยนจะถอดรหัสของเดิมไม่ได้
TOKEN_ENCRYPTION_KEY=

# ── Error tracking ──────────────────────────────────────────────────────────
# [ต่างจากเทสต์] เครื่องทดสอบไม่ได้ตั้งไว้เลย = ถ้า production พังจะไม่มีใครรู้จนกว่าจะมีคนแจ้ง
# (บอสสั่งเรื่องนี้ไว้ 24 ก.ย. 69) NEXT_PUBLIC_* ถูกฝังตอน build — เปลี่ยนแล้วต้อง build web ใหม่
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# ── พอร์ต (ไม่ได้เปิดออก host ใน production — Caddy เป็นทางเข้าเดียว) ───────
API_PORT=4301
WEB_PORT=3000
POSTGRES_PORT=5432
