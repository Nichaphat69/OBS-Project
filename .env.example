# คัดลอกไฟล์นี้เป็น .env แล้วใส่ค่าจริง — ห้าม commit ไฟล์ .env

# ── พอร์ตที่เปิดเว็บ ─────────────────────────────────────────
# เครื่องนี้มีโปรเจคอื่นใช้ 3000 อยู่แล้ว จึงตั้ง 4300 เป็นค่าเริ่มต้นเวลาทดสอบ
PORT=4300

# ── ผู้ใช้ที่ล็อกอิน ────────────────────────────────────────
# ไม่มีค่าให้ตั้งที่นี่แล้ว — ทุกคนต้อง login ด้วยบัญชีของตัวเอง (เดิมใช้ ACTOR ตัวเดียว
# ของทั้งเซิร์ฟเวอร์ ทำให้ audit log ผิดความจริงทันทีที่มีคนที่สองมาใช้)
# สร้างบัญชีแรกด้วย `npm run user:create` ก่อนเปิดเว็บ — ดูหัวข้อ "เข้าสู่ระบบ" ใน README.md

# ── FlowAccount ────────────────────────────────────────────
# dry-run  = ไม่เรียก API จริง คืนเลขเอกสารเสมือน (ค่าเริ่มต้น ใช้ทดสอบได้ทั้ง flow)
# sandbox  = เรียก API จริงบน sandbox
# live     = production — เปลี่ยนเมื่อเทียบ FIELD_MAP กับ API docs ครบแล้วเท่านั้น
FLOWACCOUNT_MODE=dry-run
FLOWACCOUNT_CLIENT_ID=
FLOWACCOUNT_CLIENT_SECRET=
# base ของ sandbox ตามที่ FlowAccount ให้มา — token กับเอกสารอยู่ใต้ base เดียวกัน
# ({base}/token · {base}/tax-invoices/inline) · โหมด live ต้องให้ฝ่ายบัญชียืนยัน base ก่อน
FLOWACCOUNT_BASE_URL=https://openapi.flowaccount.com/test
FLOWACCOUNT_SCOPE=flowaccount-api

# ── AI ในเครื่อง (LM Studio/Ollama) — อ่าน PDF Timesheet + ร่างอีเมล ──
# ไม่พึ่งบริการ AI ภายนอกเลย ต้องเปิด Local Server ไว้ก่อนใช้งานสองจุดนี้
# ที่อยู่ local server แบบ OpenAI-compatible — LM Studio ค่าเริ่มต้นคือพอร์ตนี้
# (Ollama ก็ใช้รูปแบบเดียวกันที่ http://localhost:11434/v1)
LOCAL_LLM_BASE_URL=http://localhost:1234/v1
# ชื่อโมเดลต้องตรงกับ "API Model Identifier" ที่ LM Studio โชว์ไว้เป๊ะ (เช่น google/gemma-4-e2b)
# ใช้โมเดลเดียวกันทั้งสองตัวแปรได้ถ้าโมเดลนั้นรองรับ vision — แนะนำให้ใช้ตัวเดียวกันถ้าเครื่อง
# โหลดหลายโมเดลพร้อมกันไม่ไหว (ตรวจสอบด้วย `lms ps` ก่อน — ถ้าเครื่องรองรับหลายโมเดล
# จะแยกโมเดลเล็ก/เร็วไว้ร่างอีเมล กับโมเดล vision ไว้อ่าน PDF ก็ได้)
# โมเดลข้อความล้วน — ใช้ร่าง/อ่านอีเมล
LOCAL_LLM_MODEL=google/gemma-4-e2b
# โมเดลที่รับภาพได้ — ใช้อ่าน PDF Timesheet (ต้องรองรับ vision — Gemma 2B ธรรมดาทำไม่ได้)
LOCAL_LLM_VISION_MODEL=google/gemma-4-e2b

# ── ฐานข้อมูล ──────────────────────────────────────────────
# ค่าเริ่มต้น: ./data/billing.sqlite
# DB_PATH=/path/to/billing.sqlite

# ── Gmail (ขั้นที่ 1 ดึงเมล · ขั้นที่ 4 สร้างร่าง) ──────────
# ได้จาก Google Cloud Console → Credentials → OAuth client ID (Web application)
# redirect URI ต้องใส่: http://localhost:4399/oauth/callback
# แล้วรัน `npm run gmail:auth` เพื่อขอ refresh token
#
# ระบบไม่มีโค้ดส่งอีเมลเลย — สร้างได้แค่ "ร่าง" ในกล่อง Drafts
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

# คำค้นที่ใช้หาอีเมลแจ้งอนุมัติ Timesheet (Gmail search syntax)
GMAIL_QUERY=subject:(TimeSheet OR "แจ้งอนุมัติ") has:attachment filename:pdf newer_than:90d

# ── ที่อยู่เว็บของระบบนี้เอง — ใช้แนบเป็นลิงก์ในข้อความ LINE ───
# ต้องเป็น URL ที่มือถือ (เครื่องที่เปิด LINE) เข้าถึงได้จริง — localhost ใช้ไม่ได้เพราะมือถือ
# ไม่ใช่เครื่องเดียวกับเซิร์ฟเวอร์ ตั้งเป็น IP ในวง LAN, โดเมนจริง, หรือ URL ที่เปิด tunnel ไว้
# ไม่ใส่ = ข้อความ LINE จะไม่มีลิงก์ให้กด (ยังส่งข้อความได้ตามปกติ)
APP_BASE_URL=

# ── LINE (ขั้น 4.2 — ประตูมนุษย์ก่อนสร้างร่างใน FlowAccount) ─
# ได้จาก LINE Developers Console → Messaging API channel
# ไม่ใส่ = /request-approval ใช้ไม่ได้ (ยังส่งเข้า LINE ไม่ได้) แต่ที่เหลือของระบบรันได้ตามปกติ
LINE_CHANNEL_ACCESS_TOKEN=
# ใช้ตรวจลายเซ็น webhook เท่านั้น — ห้ามหลุดออกไปนอกเซิร์ฟเวอร์
LINE_CHANNEL_SECRET=
# userId หรือ groupId ที่จะส่งคำขออนุมัติไปให้ — ตั้งเป็นแชทเฉพาะฝ่ายบัญชี
# อย่าตั้งเป็นกลุ่มรวมทีม เพราะข้อความมีตัวเลขเงินเดือน
LINE_APPROVER_TARGET=
# รายชื่อ userId ที่มีสิทธิ์กดอนุมัติ/ตีกลับ คั่นด้วยจุลภาค — ว่าง = ปิดรับทุกคน (ปลอดภัยไว้ก่อน)
# หา userId ได้จาก event.source.userId ตอนทดสอบยิง webhook ครั้งแรก
LINE_APPROVER_USER_IDS=
