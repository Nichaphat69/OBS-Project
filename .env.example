# คัดลอกไฟล์นี้เป็น .env แล้วใส่ค่าจริง — ห้าม commit ไฟล์ .env

# ── พอร์ตที่เปิดเว็บ ─────────────────────────────────────────
# เครื่องนี้มีโปรเจคอื่นใช้ 3000 อยู่แล้ว จึงตั้ง 4300 เป็นค่าเริ่มต้นเวลาทดสอบ
PORT=4300

# ── ผู้ใช้ที่ล็อกอิน ────────────────────────────────────────
# ไม่มีค่าให้ตั้งที่นี่แล้ว — ทุกคนต้อง login ด้วยบัญชีของตัวเอง (เดิมใช้ ACTOR ตัวเดียว
# ของทั้งเซิร์ฟเวอร์ ทำให้ audit log ผิดความจริงทันทีที่มีคนที่สองมาใช้)
# สร้างบัญชีแรกด้วย `npm run user:create` ก่อนเปิดเว็บ — ดูหัวข้อ "เข้าสู่ระบบ" ใน README.md

# ── เข้าสู่ระบบด้วย Google (31 ส.ค. 69 ตามที่ขอ) ─────────────
# ได้จาก Google Cloud Console → APIs & Services → Credentials → OAuth client ID (Web application)
# ไม่ใส่ครบ = ปุ่ม "เข้าสู่ระบบด้วย Google" จะไม่โผล่ในหน้า login เลย (ที่เหลือของระบบใช้ได้ปกติ)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Authorized redirect URI ที่ต้องใส่ในหน้า Credentials ให้ตรงกับค่านี้เป๊ะ: {ค่านี้}
# ไม่ใส่ = คำนวณจาก header Host ของคำขอเอง (ใช้ได้เฉพาะทดสอบในเครื่อง ห้ามใช้กับ production
# ที่อยู่หลัง reverse proxy เพราะ Host อาจไม่ตรงกับโดเมนจริงที่คนเข้าเว็บ)
GOOGLE_REDIRECT_URI=

# ── FlowAccount ────────────────────────────────────────────
# dry-run  = ไม่เรียก API จริง คืนเลขเอกสารเสมือน (ค่าเริ่มต้น ใช้ทดสอบได้ทั้ง flow)
# sandbox  = เรียก API จริงบน sandbox
# live     = production — เปลี่ยนเมื่อเทียบ FIELD_MAP กับ API docs ครบแล้วเท่านั้น
FLOWACCOUNT_MODE=dry-run
FLOWACCOUNT_CLIENT_ID=
FLOWACCOUNT_CLIENT_SECRET=
# base ของ sandbox ตามที่ FlowAccount ให้มา — token กับเอกสารอยู่ใต้ base เดียวกัน
# ({base}/token · {base}/tax-invoices/inline) · โหมด live ต้องให้ฝ่ายบัญชียืนยัน base ก่อน
FLOWACCOUNT_BASE_URL=https://openapi.flowaccount.com/test
FLOWACCOUNT_SCOPE=flowaccount-api

# ── AI — อ่าน PDF Timesheet + ร่างอีเมล ──
# ใช้ endpoint แบบ OpenAI-compatible ของโมเดลที่รันในเครื่อง (LM Studio หรือ Ollama)
#   LOCAL_LLM_BASE_URL=http://localhost:1234/v1   (LM Studio) หรือ http://localhost:11434/v1 (Ollama)
#   ชื่อโมเดลต้องตรงกับ "API Model Identifier" ที่ตัวเซิร์ฟเวอร์โมเดลโชว์ไว้เป๊ะ
LOCAL_LLM_BASE_URL=http://localhost:1234/v1
LOCAL_LLM_MODEL=google/gemma-4-e2b
LOCAL_LLM_VISION_MODEL=google/gemma-4-e2b

# ── ABBYY Vantage (แทนที่ AI ในเครื่องสำหรับอ่าน PDF Timesheet — requirement 14/08/2569) ──
# ไม่ใส่ครบ 4 ตัว = ยังใช้ AI ในเครื่องด้านบนอ่าน Timesheet อยู่เหมือนเดิม (ดู src/extract/abbyy.js)
# base URL ตาม region ที่ใช้งานจริง (เช่น https://vantage-au.abbyy.com สำหรับ Australia)
ABBYY_BASE_URL=
# จากหน้า Configuration → Public API Client ใน ABBYY Vantage — ต้องติ๊ก
# "Allow client credentials flow" ไว้ด้วย ไม่งั้นเชื่อมต่อแบบอัตโนมัติ (ไม่มีคนล็อกอิน) ไม่ได้
ABBYY_CLIENT_ID=
ABBYY_CLIENT_SECRET=
# ID ของ Skill "Timesheet" ที่ train ไว้ (ดูได้จากเมนู Skill Catalog ในระบบ ABBYY Vantage)
ABBYY_SKILL_ID=

# ── Clear Read (ตัวอ่านเอกสารตัวที่สอง คู่กับ ABBYY — 16 ก.ย. 69) ──────
# ยืนยันจริงจากการยิง API ตรงๆ ไม่ใช่เดาจากเอกสาร: หน้าเว็บคือ https://clear-read.ai
# แต่ API อยู่คนละโดเมน (ดึงมาจาก JS bundle ของหน้าเว็บ)
CLEAR_READ_BASE_URL=https://ai.prior-dev.app/prior-clear-read
# ล็อกอินด้วย email/password ผ่าน POST /sign-in แล้วได้ access_token (JWT อายุ 1 ชม.)
# + refresh_token กลับมา — ไม่มีระบบ API key ให้ใช้ ต้องเก็บรหัสผ่านไว้จริงๆ
CLEAR_READ_EMAIL=
CLEAR_READ_PASSWORD=
# project_id ต้องส่งไปด้วยทุก endpoint — ดูได้จาก POST /list/project (ไม่ได้อยู่ใน JWT)
CLEAR_READ_PROJECT_ID=
# แม่แบบ "สำรอง" ใช้กับสัญญาที่ยังไม่ได้เลือกแม่แบบของตัวเอง (ปกติเลือกต่อสัญญาที่หน้าจัดการสัญญา —
# คอลัมน์ contracts.clear_read_template_id) ทำงานแบบเดียวกับ ABBYY_SKILL_ID ทุกประการ
# ค่าที่แนะนำคือ "Master Template" ซึ่ง schema ตรงกับสารบัญฟิลด์กลางใน
# packages/domain/src/timesheetFields.ts (14 ฟิลด์หัวเอกสาร + ตาราง TimesheetDetails 22 คอลัมน์)
CLEAR_READ_TEMPLATE_ID=

# ── ฐานข้อมูล ──────────────────────────────────────────────
# ค่าเริ่มต้น: ./data/billing.sqlite
# DB_PATH=/path/to/billing.sqlite

# ── Gmail (ขั้นที่ 1 ดึงเมล · ขั้นที่ 4 สร้างร่าง) ──────────
# ได้จาก Google Cloud Console → Credentials → OAuth client ID (Web application)
# redirect URI ต้องใส่: http://localhost:4399/oauth/callback
# แล้วรัน `npm run gmail:auth` เพื่อขอ refresh token
#
# ระบบไม่มีโค้ดส่งอีเมลเลย — สร้างได้แค่ "ร่าง" ในกล่อง Drafts
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

# คำค้นที่ใช้หาอีเมลแจ้งอนุมัติ Timesheet (Gmail search syntax)
GMAIL_QUERY=subject:(timesheet OR timesheets OR "time sheet" OR "time-sheet" OR อนุมัติ OR ตารางเข้างาน OR บันทึกเวลา) has:attachment filename:pdf newer_than:90d

# ── ที่อยู่เว็บของระบบนี้เอง — ใช้แนบเป็นลิงก์ในข้อความ LINE ───
# ต้องเป็น URL ที่มือถือ (เครื่องที่เปิด LINE) เข้าถึงได้จริง — localhost ใช้ไม่ได้เพราะมือถือ
# ไม่ใช่เครื่องเดียวกับเซิร์ฟเวอร์ ตั้งเป็น IP ในวง LAN, โดเมนจริง, หรือ URL ที่เปิด tunnel ไว้
# ไม่ใส่ = ข้อความ LINE จะไม่มีลิงก์ให้กด (ยังส่งข้อความได้ตามปกติ)
APP_BASE_URL=

# ── ที่อยู่เว็บของสแต็กใหม่ (Next.js apps/web) — ใช้แนบลิงก์ "ส่ง Timesheet ผ่านระบบ OBS" ใน LINE
# แยกจาก APP_BASE_URL ด้านบนซึ่งยังชี้ไปที่แอปเก่า (คนละพอร์ต/คนละหน้า — /?view=upload vs /upload)
# เงื่อนไขเดียวกับ APP_BASE_URL: ต้องเป็น URL ที่มือถือเข้าถึงได้จริง ไม่ใส่ = การ์ดจะไม่มีปุ่มลิงก์
WEB_BASE_URL=

# ── LINE (ขั้น 4.2 — ประตูมนุษย์ก่อนสร้างร่างใน FlowAccount) ─
# ได้จาก LINE Developers Console → Messaging API channel
# ไม่ใส่ = /request-approval ใช้ไม่ได้ (ยังส่งเข้า LINE ไม่ได้) แต่ที่เหลือของระบบรันได้ตามปกติ
LINE_CHANNEL_ACCESS_TOKEN=
# ใช้ตรวจลายเซ็น webhook เท่านั้น — ห้ามหลุดออกไปนอกเซิร์ฟเวอร์
LINE_CHANNEL_SECRET=
# userId หรือ groupId ที่จะส่งคำขออนุมัติไปให้ — ตั้งเป็นแชทเฉพาะฝ่ายบัญชี
# อย่าตั้งเป็นกลุ่มรวมทีม เพราะข้อความมีตัวเลขเงินเดือน
LINE_APPROVER_TARGET=
# รายชื่อ userId ที่มีสิทธิ์กดอนุมัติ/ตีกลับ คั่นด้วยจุลภาค — ว่าง = ปิดรับทุกคน (ปลอดภัยไว้ก่อน)
# หา userId ได้จาก event.source.userId ตอนทดสอบยิง webhook ครั้งแรก
LINE_APPROVER_USER_IDS=

# userId/groupId แจ้งเตือน "ระบบล่ม/error" โดยเฉพาะ (เจ้าของระบบสั่ง 24 ก.ย. 69 — แยกจาก
# LINE_APPROVER_TARGET ด้านบนตั้งใจ เพราะ error ระบบเป็นเรื่องของ admin ไม่ใช่งานอนุมัติของบัญชี)
# ไม่ตั้งไว้ = ใช้ LINE_APPROVER_TARGET แทนชั่วคราว (ยังแจ้งได้ แค่ไปปนกับแชทบัญชี)
LINE_ADMIN_TARGET=

# ── LINE Login (หน้า "เชื่อมต่อ LINE" ของพนักงาน — เชื่อมต่อคลิกเดียวแทนพิมพ์รหัส 6 หลัก) ──
# ต้องสร้าง LINE Login channel ใหม่ใน LINE Developers Console แยกจาก Messaging API channel ข้างบน
# แล้วกด Link ผูกสอง channel นี้เข้าด้วยกัน (หน้า Messaging API channel → แท็บ LINE Login) — ไม่ผูก
# sub ที่ได้จะเป็นคนละ userId กับ Messaging API ทำให้เชื่อมต่อผิดคนเงียบๆ
# Callback URL ที่ต้องใส่ในหน้า Console: <origin เว็บ>/api/my-line-link/oauth/callback
# ไม่ใส่ครบ = ปุ่ม "เชื่อมต่อด้วย LINE" จะไม่โผล่ในหน้าเว็บ เหลือแค่วิธีพิมพ์รหัส 6 หลักแบบเดิม
LINE_LOGIN_CHANNEL_ID=
LINE_LOGIN_CHANNEL_SECRET=
# ปกติไม่ต้องใส่ (ระบบเดา host จาก request เอง) — ใส่ตรงๆ เฉพาะดีพลอยที่มี reverse proxy อีกชั้น
# ที่ทำให้เดา host ผิด ต้องตรงกับ Callback URL ที่ตั้งไว้ใน Console เป๊ะ
LINE_LOGIN_REDIRECT_URI=

# ── Sentry (error tracking — เจ้าของระบบสั่ง 24 ก.ย. 69 "ไม่มี error tracking บั๊กฝั่ง production
# จะไม่มีใครรู้จนกว่าจะมีคนแจ้ง") — ไม่ใส่ = ปิดเงียบๆ ทุกอย่างรันปกติเหมือนเดิมทุกประการ ต้องสมัคร
# บัญชี Sentry เอง (มีแผนฟรี) แล้วสร้างโปรเจกต์ 2 อัน (Node.js สำหรับ apps/api, Next.js สำหรับ
# apps/web) เอา DSN จากแต่ละโปรเจกต์มาใส่ตัวแปรด้านล่าง ห้ามฝัง DSN ในโค้ด/commit ตรงๆ
SENTRY_DSN=
# ต้องมี prefix นี้เพราะรันในเบราว์เซอร์ (apps/web ฝั่ง client) — คนละค่ากับ SENTRY_DSN ด้านบนได้
# (ปกติใช้ DSN ของโปรเจกต์ Next.js เดียวกันซ้ำได้เลยทั้ง server/client)
NEXT_PUBLIC_SENTRY_DSN=

# ── shared secret สำหรับ n8n (Phase 5.6) ── ต้นฉบับไม่มี auth เลยบน endpoint พวกนี้
# (`/api/timesheets/ingest`, `/api/cycles/ready`, `/api/cycles/:id/:period/request-approval`,
# `/api/timesheets/send-overdue-reminders`) — สแต็กใหม่ปิดช่องนี้ด้วย header `x-n8n-secret` ต้องตั้ง
# HTTP Header node ใน n8n workflow ให้ส่ง header นี้มาด้วยทุกครั้ง ไม่ใส่ = เรียก endpoint พวกนี้ไม่ได้เลย
N8N_SHARED_SECRET=

# ── Phase 0-5 Next.js/Express/Prisma migration scaffold (feature/nextjs-node-prisma-migration) ──
# ใช้โดย docker-compose.yml (postgres/api/web) และ packages/db (prisma generate/migrate)
# คนละฐานข้อมูล คนละพอร์ตกับระบบเดิมทั้งหมด — ไม่กระทบ src/ เลย
POSTGRES_USER=obs
POSTGRES_PASSWORD=
POSTGRES_DB=obs
POSTGRES_PORT=5433
# ใช้จากเครื่อง host เท่านั้น (prisma generate/migrate dev, scripts/migrate-sqlite-to-postgres.ts)
# ต่อผ่านพอร์ตที่ map ออกมาที่ localhost — คอนเทนเนอร์ api ต่อผ่านชื่อ service "postgres" แทน
# (ดู docker-compose.yml)
DATABASE_URL=postgresql://obs:changeme@localhost:5433/obs?schema=public
API_PORT=4301
WEB_PORT=3000

# ── ที่เก็บไฟล์เอกสาร (Garage — พูดภาษา S3) ─────────────────────────────────
# จำเป็นตั้งแต่ 28 ก.ย. 69 — ไฟล์ไม่ได้เก็บในฐานข้อมูลแล้ว ถ้าไม่ตั้งค่าจะอัปโหลดไฟล์ไม่ได้
# ขั้นตอนตั้งค่าครั้งแรกอยู่ในคอมเมนต์เหนือ service `storage` ใน docker-compose.yml
STORAGE_ENDPOINT=http://localhost:3900
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_BUCKET=obs-files
STORAGE_REGION=garage
STORAGE_RPC_SECRET=

# ── กุญแจเข้ารหัสค่าลับที่เก็บในฐานข้อมูล ───────────────────────────────────
# ตอนนี้ใช้กับสิทธิ์เข้าถึงกล่อง Gmail ที่ผูกไว้จากหน้าเว็บ (ตาราง gmail_connections)
# สร้างด้วย `openssl rand -hex 32` · ตั้งครั้งเดียวแล้วห้ามเปลี่ยน ถ้าเปลี่ยนจะอ่านของที่เก็บไว้เดิมไม่ได้
# ไม่ตั้ง = ยังใช้ระบบได้ปกติ แต่กดปุ่มเชื่อมต่อ Gmail จากหน้าเว็บไม่ได้ (จะขึ้นข้อความบอก)
TOKEN_ENCRYPTION_KEY=
